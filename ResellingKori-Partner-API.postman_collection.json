{
  "info": {
    "name": "ResellingKori Partner API",
    "description": "Every request is signed automatically (RK2) by the collection pre-request script. Set base_url (https://resellingkori.com/wp-json/rk/v1), key_id and secret in the collection variables. Replace rk_product_id in the order bodies with a real product id from GET /products. Never share an exported collection that contains your secret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// RK2 signing for every request in this collection (ResellingKori Partner API).",
          "// Collection variables: base_url (for example https://resellingkori.com/wp-json/rk/v1), key_id and secret.",
          "const keyId = pm.collectionVariables.get('key_id') || pm.environment.get('key_id');",
          "const secret = pm.collectionVariables.get('secret') || pm.environment.get('secret');",
          "if (!keyId || !secret || keyId === 'rkk_your_key_id') {",
          "  throw new Error('Set key_id and secret in the collection variables (collection > Variables) before you send a request.');",
          "}",
          "const enc = (v) => encodeURIComponent(String(v)).replace(/[!'()*]/g, (c) => '%' + c.charCodeAt(0).toString(16).toUpperCase());",
          "// The signed route is the REST route without \"/wp-json\", for example /rk/v1/orders. When this script runs, Postman has not",
          "// replaced {{base_url}} in the URL yet, so pm.request.url.path only holds what comes after it (/orders): the prefix",
          "// (/rk/v1) is taken from base_url. A request whose URL is typed in full (https://.../wp-json/rk/v1/orders) works too.",
          "const baseUrl = pm.variables.replaceIn('{{base_url}}');",
          "const baseAt = baseUrl.indexOf('/wp-json/');",
          "const basePrefix = baseAt >= 0 ? baseUrl.slice(baseAt + 8).replace(/[?#].*$/, '').replace(/\\/+$/, '') : '';",
          "const own = '/' + pm.request.url.path.map((p) => pm.variables.replaceIn(p)).join('/');",
          "const ownAt = own.indexOf('/wp-json/');",
          "let route = ownAt >= 0 ? own.slice(ownAt + 8) : basePrefix + own;",
          "const params = {};",
          "pm.request.url.query.each((q) => {",
          "  if (q.disabled) return;",
          "  const k = pm.variables.replaceIn(q.key);",
          "  const v = pm.variables.replaceIn(q.value == null ? '' : q.value);",
          "  if (k === 'rest_route') { route = decodeURIComponent(v); } else { params[k] = v; }",
          "});",
          "if (route.indexOf('/rk/v1/') !== 0) {",
          "  throw new Error('Cannot work out the API route (got \"' + route + '\"). Set base_url to https://resellingkori.com/wp-json/rk/v1 in the collection variables.');",
          "}",
          "const query = Object.keys(params).sort().map((k) => enc(k) + '=' + enc(params[k])).join('&');",
          "const method = pm.request.method.toUpperCase();",
          "let body = '';",
          "if (method !== 'GET' && pm.request.body && pm.request.body.raw) {",
          "  body = pm.variables.replaceIn(pm.request.body.raw);",
          "  pm.request.body.raw = body; // send exactly the bytes that are signed",
          "}",
          "const ts = Math.floor(Date.now() / 1000);",
          "const nonce = CryptoJS.lib.WordArray.random(16).toString(CryptoJS.enc.Hex);",
          "const canonical = ['RK2', String(ts), nonce, method, route, query, CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex)].join('\\n');",
          "const sig = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-RK-Key', value: keyId });",
          "pm.request.headers.upsert({ key: 'X-RK-Timestamp', value: String(ts) });",
          "pm.request.headers.upsert({ key: 'X-RK-Nonce', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-RK-Signature', value: sig });",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://resellingkori.com/wp-json/rk/v1"
    },
    {
      "key": "key_id",
      "value": "rkk_your_key_id"
    },
    {
      "key": "secret",
      "value": ""
    }
  ],
